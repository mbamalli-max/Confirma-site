{
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Frame-Options": "DENY",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(self), geolocation=()",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://api.konfirmata.com; media-src 'self' blob:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
      },
      "continue": true
    },
    {
      "src": "/app/sw\\.js",
      "headers": { "Service-Worker-Allowed": "/app" },
      "continue": true
    },
    { "src": "/\\.well-known/verification-key\\.json", "dest": "https://api.konfirmata.com/.well-known/verification-key.json" },
    { "src": "/app/?", "dest": "/app-v3/index.html" },
    { "src": "/app/sw\\.js", "dest": "/app-v3/sw.js" },
    { "src": "/app/manifest\\.json", "dest": "/app-v3/manifest.json" },
    { "src": "/app/icons/(.*)", "dest": "/app-v3/icons/$1" },
    { "src": "/app/(.*)", "dest": "/app-v3/$1" },
    { "src": "/verify", "dest": "/website-v2/verify.html" },
    { "src": "/verify/", "dest": "/website-v2/verify.html" },
    { "src": "/verify/(.*)", "dest": "/website-v2/verify.html" },
    { "src": "/lenders\\.html", "status": 308, "headers": { "Location": "/institutions.html" } },
    { "src": "/banks\\.html", "status": 308, "headers": { "Location": "/institutions.html" } },
    { "src": "/", "dest": "/website-v2/index.html" },
    { "src": "/admin(/.*)?", "status": 404 },
    { "src": "/(.*)", "dest": "/website-v2/$1" }
  ]
}
