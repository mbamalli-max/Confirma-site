{
  "headers": [
    {
      "source": "/app/sw.js",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://api.konfirmata.com; media-src 'self' blob:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" },
        { "key": "Service-Worker-Allowed", "value": "/app" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://api.konfirmata.com; media-src 'self' blob:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ],
  "routes": [
    { "src": "/\\.well-known/verification-key\\.json", "dest": "https://api.konfirmata.com/.well-known/verification-key.json" },
    { "src": "/app/?", "dest": "/app-v3/index.html" },
    { "src": "/app/sw\\.js", "dest": "/app-v3/sw.js" },
    { "src": "/app/manifest\\.json", "dest": "/app-v3/manifest.json" },
    { "src": "/app/icons/(.*)", "dest": "/app-v3/icons/$1" },
    { "src": "/app/(.*)", "dest": "/app-v3/$1" },
    { "src": "/verify", "dest": "/website-v2/verify.html" },
    { "src": "/verify/", "dest": "/website-v2/verify.html" },
    { "src": "/verify/(.*)", "dest": "/website-v2/verify.html" },
    { "src": "/lenders\\.html", "status": 308, "headers": { "Location": "/institutions.html" } },
    { "src": "/", "dest": "/website-v2/index.html" },
    { "src": "/(.*)", "dest": "/website-v2/$1" }
  ]
}
