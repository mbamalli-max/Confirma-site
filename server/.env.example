# Existing server variables are documented by the deployment environment.
# Admin authentication uses separate secrets and origins.
ADMIN_JWT_SECRET=
ADMIN_TOTP_ENC_KEY=
ADMIN_JWT_EXPIRY=1h
ADMIN_CORS_ORIGINS=
ADMIN_IP_ALLOWLIST=
ADMIN_K_ANON_THRESHOLD=5
# TRUST_PROXY must match the deployment edge's verified proxy CIDRs. A hop count is
# unsafe until edge-only reachability and forwarding behavior are verified. Leaving
# this unset disables proxy trust; an unverified value makes the admin IP allowlist,
# login rate limit, and recorded session IPs meaningless.
TRUST_PROXY=

# Generate ADMIN_JWT_SECRET with a cryptographically secure random generator.
# Generate the exact 32-byte hexadecimal AES key with:
# openssl rand -hex 32
